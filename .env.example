# WebPageTest Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Server Configuration
SERVER_PORT=4000

# Agent Configuration
SERVER_URL=http://localhost:4000/work/
LOCATION=Test
# Optional: Set a custom name for the agent
# NAME=my-agent

# Network Configuration
# Use host networking for the agent (recommended for most setups)
# Set to "bridge" if you want to use bridge networking instead
AGENT_NETWORK_MODE=host